# Folder that holds consignment.db and the reports folder.
# Leave this unset during development to use ./data inside the project.
# The Mac install writes an absolute path:
#   ~/Library/Application Support/CottonAndClay/data
# CONSIGNMENT_DATA_DIR=

# Set to 0 to create an empty database instead of the sample shops.
# The Mac server sets this to 0. Leave it unset to load the samples on first launch.
# CONSIGNMENT_SEED=0

# Where npm run backup writes dated copies. Defaults to a backups folder
# beside the data repository.
# CONSIGNMENT_BACKUP_DIR=

# How many dated backups to keep. Defaults to 14.
# CONSIGNMENT_BACKUP_KEEP=14

# Set to 1 inside the Docker image so the dashboard does not advertise
# the container’s private 172.x address. The Mac install also sets:
# CONSIGNMENT_DOCKER=1
# CONSIGNMENT_PUBLIC_URLS=https://consignment.mac.tailnet.ts.net,http://macbook:43123
# CONSIGNMENT_BONJOUR=cotton-clay.local
# After homeserver proxies the tracker, set the bookmark people should use:
# CONSIGNMENT_HOMESERVER_URL=https://consignment.mac.tailnet.ts.net

# Shared access code for Mini / iPad / iPhone. Required before Funnel
# (public URL, no Tailscale app on those devices). Leave empty in development.
# CONSIGNMENT_ACCESS_CODE=

# Read-only Shopify inventory. Location name matches a store name; SKU
# matches the consignee code, otherwise the product name is used.
# We never write Shopify quantities back onto our shelves.
# SHOPIFY_SHOP=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...
# Local snapshot for development only:
# SHOPIFY_MOCK_JSON=./fixtures/shopify-inventory.example.json
